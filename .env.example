# Shepherd Staffing — environment variables.
# Copy to .env for local dev. In production set these in Vercel → Settings → Environment Variables.
# NEVER commit real values. NEVER paste secrets into chat.

# ── Database (Postgres / Supabase) ─────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: the pooled "Transaction" URL (port 6543) for the app.
# DIRECT_URL:   the direct URL (port 5432), used only for migrations.
DATABASE_URL="postgresql://shepherd:shepherd@localhost:5432/shepherd_app"
DIRECT_URL=""

# ── Core secrets (generate with: npm run gen:secrets) ──────────────────
JWT_SECRET=""                # ≥ 64 random bytes; signs session cookies
ENCRYPTION_KEY=""            # 32 bytes, base64; AES-256-GCM for private fields. BACK IT UP — losing it loses that data.
ENCRYPTION_KEY_VERSION=1     # bump when rotating; old key goes in ENCRYPTION_KEY_PREVIOUS
ENCRYPTION_KEY_PREVIOUS=""
CRON_SECRET=""               # ≥ 32 chars; Vercel cron sends it as a Bearer token

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # https://shepherdstaffing.com in production
ADMIN_EMAILS=""              # comma-separated; these become admin on first verified login
SUPPORT_EMAIL="support@shepherdstaffing.com"  # PLACEHOLDER — confirm before launch

# ── Upstash Redis (rate limits, counters, entitlement cache) ───────────
# Required in production. Without it, dev falls back to per-process memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Anthropic (server-only) ────────────────────────────────────────────
ANTHROPIC_API_KEY=""         # set a monthly spend limit in the Anthropic console
ANTHROPIC_MODEL=""           # model ID, e.g. from docs.anthropic.com/en/docs/about-claude/models

# ── Stripe (server-only; test-mode keys until launch) ──────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""     # from the webhook endpoint pointing at /api/webhooks/stripe
STRIPE_PRICE_PLATFORM_MONTHLY=""   # price_… for $49/mo
STRIPE_PRICE_PLATFORM_ANNUAL=""    # price_… for $299/yr

# ── Brevo email ────────────────────────────────────────────────────────
BREVO_API_KEY=""
EMAIL_FROM="no-reply@shepherdstaffing.com"
EMAIL_FROM_NAME="Shepherd Staffing"

# ── Optional ───────────────────────────────────────────────────────────
BACKGROUND_CHECK_VENDOR=""   # e.g. checkr (not enabled until vendor onboarding)
BACKGROUND_CHECK_API_KEY=""
# STORAGE_* for v1.1 interview recordings (Cloudflare R2 / S3), added when that ships.
